# Server Configuration
PORT=3000
APP_URL=http://localhost:3000

# Gemini AI (for AI Artisan Assistant / Scoping)
GEMINI_API_KEY=

# Supabase Auth & Database (Optional: falls back to in-memory store if unset)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox (Optional: falls back to CartoDB/OSM high-resolution tiles if unset)
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# Didit Identity Verification Service (Server-side Only)
# API key and workflow are required for live hosted KYC sessions.
# The webhook secret is optional during local development; status can be refreshed after the user returns.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_ENVIRONMENT=live
